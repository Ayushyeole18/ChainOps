<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="com.supplychainx.controller.MainLayoutController"
            prefHeight="800" prefWidth="1280">

    <!-- Persistent Left Sidebar Navigation -->
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <!-- Brand Logo -->
            <VBox styleClass="sidebar-brand-box" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="ChainOps" styleClass="brand-title"/>
                    <Label text="v1.0" style="-fx-text-fill: #38BDF8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-color: #0369A1; -fx-padding: 2 6 2 6; -fx-background-radius: 4;"/>
                </HBox>
                <Label text="Supply Chain System" styleClass="brand-subtitle"/>
            </VBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="4" style="-fx-background-color: transparent;">
                    <Button fx:id="navDashboard" text="📊  Dashboard" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navAiIntelligence" text="🧠  AI / ML Intelligence" onAction="#showAiIntelligence" maxWidth="Infinity" styleClass="nav-button"/>

                    <Label text="OPERATIONS" styleClass="sidebar-section-header"/>
                    <Button fx:id="navInventory" text="📦  Inventory" onAction="#showInventory" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navPurchaseOrders" text="📝  Purchase Orders" onAction="#showPurchaseOrders" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navSalesOrders" text="🛒  Sales Orders" onAction="#showSalesOrders" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navShipments" text="🚚  Shipments" onAction="#showShipments" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navStockTransfers" text="🔄  Stock Transfers" onAction="#showStockTransfers" maxWidth="Infinity" styleClass="nav-button"/>

                    <Label text="MASTER DATA" styleClass="sidebar-section-header"/>
                    <Button fx:id="navProducts" text="🏷️  Products" onAction="#showProducts" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navCategories" text="📁  Categories" onAction="#showCategories" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navSuppliers" text="🏭  Suppliers" onAction="#showSuppliers" maxWidth="Infinity" styleClass="nav-button"/>
                    <Button fx:id="navWarehouses" text="🏢  Warehouses" onAction="#showWarehouses" maxWidth="Infinity" styleClass="nav-button"/>

                    <Label text="ANALYTICS" styleClass="sidebar-section-header"/>
                    <Button fx:id="navReports" text="📈  Reports &amp; Export" onAction="#showReports" maxWidth="Infinity" styleClass="nav-button"/>

                    <Label text="ADMINISTRATION" styleClass="sidebar-section-header"/>
                    <Button fx:id="navUsers" text="👥  User Management" onAction="#showUsers" maxWidth="Infinity" styleClass="nav-button"/>
                </VBox>
            </ScrollPane>

            <!-- Bottom Session Box -->
            <VBox spacing="8" style="-fx-padding: 12 0 0 0; -fx-border-color: #1E293B; -fx-border-width: 1 0 0 0;">
                <Button text="🚪  Sign Out" onAction="#handleLogout" maxWidth="Infinity" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Top Navigation Header -->
    <top>
        <HBox styleClass="top-bar">
            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <Label fx:id="currentViewTitle" text="Dashboard Overview" styleClass="top-bar-title"/>
                <Label text="CONNECTED" styleClass="badge-success"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="16">
                <HBox alignment="CENTER" spacing="8" styleClass="user-profile-badge">
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="userFullNameLabel" text="Administrator" styleClass="user-profile-text"/>
                        <Label fx:id="userRoleBadge" text="System Admin" styleClass="user-role-text"/>
                    </VBox>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- Main Dynamic Content Workspace -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F8FAFC;">
            <!-- Dynamic view nodes injected here by NavigationManager -->
        </StackPane>
    </center>
</BorderPane>
