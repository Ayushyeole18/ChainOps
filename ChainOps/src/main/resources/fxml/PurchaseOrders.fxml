<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.supplychainx.controller.PurchaseOrderController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20">
        <padding>
            <Insets top="20" right="24" bottom="24" left="24"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Procurement &amp; Purchase Orders" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                <Label text="Draft inbound procurement orders, approve vendor contracts, and receive physical shipments into warehouse stock" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
            </VBox>
        </HBox>

        <!-- Search & Filter Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="content-panel" style="-fx-padding: 12 16 12 16;">
            <TextField fx:id="searchField" promptText="🔍 Search PO number, supplier, or warehouse..." prefWidth="300" styleClass="text-field"/>
            <ComboBox fx:id="statusFilterCombo" prefWidth="150" styleClass="combo-box"/>
            <Button text="Filter" onAction="#handleSearchAndFilter" styleClass="btn-primary"/>
            <Button text="Reset" onAction="#handleResetFilter" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="✔️ Approve Order" onAction="#handleApproveSelected" styleClass="btn-secondary" style="-fx-text-fill: #2563EB; -fx-border-color: #93C5FD;"/>
            <Button text="📥 Receive Stock" onAction="#handleReceiveSelected" styleClass="btn-success"/>
            <Button text="✖ Cancel" onAction="#handleCancelSelected" styleClass="btn-danger"/>
        </HBox>

        <!-- Existing Purchase Orders Table -->
        <VBox styleClass="content-panel" spacing="12">
            <Label text="Purchase Order Ledger" styleClass="content-header-title"/>
            <TableView fx:id="poTable" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colPoNumber" text="PO #" prefWidth="120"/>
                    <TableColumn fx:id="colSupplier" text="Supplier Vendor" prefWidth="180"/>
                    <TableColumn fx:id="colWarehouse" text="Dest Warehouse" prefWidth="140"/>
                    <TableColumn fx:id="colOrderDate" text="Order Date" prefWidth="100"/>
                    <TableColumn fx:id="colExpectedDate" text="Expected Date" prefWidth="105"/>
                    <TableColumn fx:id="colTotal" text="Total Cost ($)" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                    <TableColumn fx:id="colCreatedBy" text="Created By" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Create New Purchase Order Form -->
        <VBox styleClass="content-panel" spacing="16">
            <Label text="Draft New Purchase Order" styleClass="content-header-title"/>
            <Label text="Configure vendor, delivery facility, and order line items" styleClass="content-header-desc"/>

            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0" spacing="4">
                    <Label text="Supplier Vendor" styleClass="form-label"/>
                    <ComboBox fx:id="supplierCombo" maxWidth="Infinity" styleClass="combo-box"/>
                </VBox>

                <VBox GridPane.columnIndex="1" spacing="4">
                    <Label text="Destination Warehouse" styleClass="form-label"/>
                    <ComboBox fx:id="warehouseCombo" maxWidth="Infinity" styleClass="combo-box"/>
                </VBox>

                <VBox GridPane.columnIndex="2" spacing="4">
                    <Label text="Order Date" styleClass="form-label"/>
                    <DatePicker fx:id="orderDatePicker" maxWidth="Infinity" styleClass="date-picker"/>
                </VBox>

                <VBox GridPane.columnIndex="3" spacing="4">
                    <Label text="Expected Delivery Date" styleClass="form-label"/>
                    <DatePicker fx:id="expectedDatePicker" maxWidth="Infinity" styleClass="date-picker"/>
                </VBox>
            </GridPane>

            <!-- Line Items Builder -->
            <VBox spacing="10" style="-fx-background-color: #F8FAFC; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                <Label text="Line Items" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Product Item" styleClass="form-label"/>
                        <ComboBox fx:id="productCombo" maxWidth="Infinity" styleClass="combo-box"/>
                    </VBox>
                    <VBox spacing="4" prefWidth="120">
                        <Label text="Qty Ordered" styleClass="form-label"/>
                        <TextField fx:id="quantityField" promptText="e.g. 100" styleClass="text-field"/>
                    </VBox>
                    <VBox spacing="4" prefWidth="130">
                        <Label text="Unit Cost ($)" styleClass="form-label"/>
                        <TextField fx:id="unitCostField" promptText="0.00" styleClass="text-field"/>
                    </VBox>
                    <VBox spacing="4" alignment="BOTTOM_LEFT">
                        <Label text=" "/>
                        <Button text="➕ Add Item" onAction="#handleAddItem" styleClass="btn-secondary"/>
                    </VBox>
                </HBox>

                <TableView fx:id="itemsTable" prefHeight="160">
                    <columns>
                        <TableColumn fx:id="colItemSku" text="SKU" prefWidth="110"/>
                        <TableColumn fx:id="colItemName" text="Product Name" prefWidth="250"/>
                        <TableColumn fx:id="colItemQty" text="Qty" prefWidth="80"/>
                        <TableColumn fx:id="colItemCost" text="Unit Cost ($)" prefWidth="110"/>
                        <TableColumn fx:id="colItemSubtotal" text="Subtotal ($)" prefWidth="120"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="16">
                    <Button text="Remove Selected Item" onAction="#handleRemoveItem" styleClass="btn-secondary" style="-fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Total Purchase Cost:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="totalAmountLabel" text="$0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                </HBox>
            </VBox>

            <VBox spacing="4">
                <Label text="Order Notes / Delivery Instructions" styleClass="form-label"/>
                <TextArea fx:id="notesArea" promptText="Add shipment instructions or inspection terms..." prefRowCount="2" styleClass="text-field"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button text="Submit &amp; Create Purchase Order" onAction="#handleCreateOrder" styleClass="btn-primary" style="-fx-padding: 10 24 10 24; -fx-font-size: 13px;"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
