<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.supplychainx.controller.WarehouseController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="20">
        <padding>
            <Insets top="20" right="24" bottom="24" left="24"/>
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Warehouses &amp; Fulfillment Centers" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                <Label text="Monitor storage capacity utilization, facility managers, and regional supply distribution nodes" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
            </VBox>
        </HBox>

        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="content-panel" style="-fx-padding: 12 16 12 16;">
            <TextField fx:id="searchField" promptText="🔍 Search warehouse name, code, manager, city..." prefWidth="320" styleClass="text-field"/>
            <Button text="Search" onAction="#handleSearch" styleClass="btn-primary"/>
            <Button text="Reset" onAction="#handleReset" styleClass="btn-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="➕ New Warehouse" onAction="#handleNewWarehouse" styleClass="btn-secondary" style="-fx-text-fill: #2563EB; -fx-border-color: #93C5FD;"/>
            <Button text="🗑️ Delete" onAction="#handleDeleteWarehouse" styleClass="btn-danger"/>
        </HBox>

        <GridPane hgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="62"/>
                <ColumnConstraints percentWidth="38"/>
            </columnConstraints>

            <!-- Table -->
            <VBox GridPane.columnIndex="0" styleClass="content-panel" spacing="12">
                <Label text="Active Logistics Facilities" styleClass="content-header-title"/>
                <TableView fx:id="warehouseTable" prefHeight="450" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
                        <TableColumn fx:id="colCode" text="Code" prefWidth="95"/>
                        <TableColumn fx:id="colName" text="Warehouse Name" prefWidth="170"/>
                        <TableColumn fx:id="colLocation" text="Location" prefWidth="140"/>
                        <TableColumn fx:id="colManager" text="Facility Manager" prefWidth="120"/>
                        <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="75"/>
                        <TableColumn fx:id="colUtil" text="Utilized" prefWidth="75"/>
                        <TableColumn fx:id="colPct" text="Load %" prefWidth="65"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="85"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Form -->
            <VBox GridPane.columnIndex="1" styleClass="content-panel" spacing="12">
                <Label fx:id="formTitleLabel" text="Add New Warehouse Hub" styleClass="content-header-title"/>
                <Label text="Define facility capacity ceilings and operations management" styleClass="content-header-desc"/>

                <VBox spacing="10">
                    <VBox spacing="4">
                        <Label text="Warehouse Code (Unique)" styleClass="form-label"/>
                        <TextField fx:id="codeField" promptText="e.g. WH-CHI-01" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Facility Name" styleClass="form-label"/>
                        <TextField fx:id="nameField" promptText="Central Fulfillment Hub - Chicago" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Physical Location / Address" styleClass="form-label"/>
                        <TextField fx:id="locationField" promptText="4500 Industrial Dr, Chicago, IL" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Facility Manager Name" styleClass="form-label"/>
                        <TextField fx:id="managerField" promptText="Elena Rostova" styleClass="text-field"/>
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Max Storage Units" styleClass="form-label"/>
                            <TextField fx:id="capacityField" promptText="50000" styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Operating Status" styleClass="form-label"/>
                            <ComboBox fx:id="statusCombo" maxWidth="Infinity" styleClass="combo-box"/>
                        </VBox>
                    </HBox>

                    <Button text="💾 Save Warehouse Hub" onAction="#handleSaveWarehouse" maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 10; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
